\name{BreedReliabR-package}
\alias{BreedReliabR}
\alias{BreedReliabR-package}
\docType{package}
\title{Decision Reliability for Genomic Genotype Advancement Across Target Environments}
\description{A research prototype implementing a model-agnostic decision-reliability layer for genotype advancement from genomic genotype-by-environment predictions. It propagates correlated prediction uncertainty together with finite sampling of a user-specified target population of environments.}
\details{The package does not fit genomic prediction models. It consumes predicted environmental response coefficients and their full joint covariance, then evaluates uncertainty and advancement reliability conditional on a specified target population of environments.}
\author{Ashutosh Sawarkar}
