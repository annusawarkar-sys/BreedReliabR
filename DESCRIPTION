Package: BreedReliabR
Type: Package
Title: Decision Reliability for Genotype Advancement under Prediction and Target Environment Uncertainty
Version: 0.1.1
Authors@R: c(
    person("Ashutosh", "Sawarkar", role = c("aut", "cre"),
        email = "annu.sawarkar@gmail.com",
        comment = c(ORCID = "0000-0002-1016-8822")),
    person("Santosh", "Patil", role = "aut",
